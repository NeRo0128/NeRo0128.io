---
// src/components/ui/Button.astro
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
}
const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  id,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold tracking-tight transition-all duration-300 active:scale-95';

const variants = {
  primary:
    'bg-brand-orange hover:bg-brand-orange-light text-surface-black shadow-[0_0_25px_rgba(255,85,0,0.35)] hover:shadow-[0_0_30px_rgba(255,85,0,0.6)]',
  secondary:
    'bg-surface-card hover:bg-surface-card-hover border border-border-subtle hover:border-brand-orange text-text-primary font-mono',
  ghost:
    'text-text-secondary hover:text-text-primary hover:text-brand-orange',
};
---

{
  href ? (
    <a href={href} class:list={[base, variants[variant], className]} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[base, variants[variant], className]} id={id}>
      <slot />
    </button>
  )
}
