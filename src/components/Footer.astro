---
// src/components/Footer.astro
import Icon from "./ui/Icon.astro";
import type { Lang } from "../i18n/ui";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
const homeHref = lang === "es" ? "/" : "/en/";

const socials = [
    {
        label: "GitHub",
        href: "https://github.com/NeRo0128",
        icon: "code",
    },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/vibeweb-studio-711782447",
        icon: "work",
    },
    {
        label: "Email",
        href: "mailto:castillovegarodolfogilberto@gmail.com",
        icon: "mail",
    },
];
---

<footer class="py-12 border-t border-border-subtle bg-surface-dark/80 text-text-secondary font-mono text-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">

        <div class="flex items-center gap-3 flex-wrap justify-center">
            <div class="w-6 h-6 rounded-full overflow-hidden flex items-center justify-center bg-surface-card border border-border-subtle">
                <span class="text-brand-orange font-bold text-[9px]">R</span>
            </div>
            <span class="text-text-primary font-bold">RCV.studio</span>
            <span class="text-text-muted">© {year} Rodolfo Castillo Vega. All systems operational.</span>
        </div>

        <div class="flex items-center gap-1 text-text-muted">
            {socials.map((s) => (
                <a
                    href={s.href}
                    target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                    rel={s.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                    class="px-2.5 py-1.5 rounded-full hover:bg-surface-card hover:text-brand-orange transition-all flex items-center gap-1.5"
                >
                    <Icon name={s.icon} size={13} />
                    <span>{s.label}</span>
                </a>
            ))}

            <a
                href={homeHref}
                class="ml-2 px-2.5 py-1.5 rounded-full bg-surface-card border border-border-subtle text-text-primary hover:border-brand-orange hover:text-brand-orange transition-all flex items-center gap-1"
            >
                <span>Top</span>
                <Icon name="arrow_upward" size={12} />
            </a>
        </div>

    </div>
</footer>
